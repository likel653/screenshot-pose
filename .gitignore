# This workspace also contains local capture data, models and release builds.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/README_中文.md
!/LICENSE
!/requirements.txt
!/build_package.py
!/screenshot_pose/
/screenshot_pose/*
!/screenshot_pose/*.py
!/screenshot_pose/*.txt
!/screenshot_pose/face_template.json
!/screenshot_pose/sam_geometry.json
!/screenshot_pose/local_runtime.example.json

!/integrations/
/integrations/*
!/integrations/screenshot-pose-project/
**/local_config.json
**/local_runtime.json
**/__pycache__/
*.py[cod]

!/tests/
/tests/*
!/tests/test_*.py
!/tests/blender_finger_hinge_test.py
!/tests/perspective_eve_regression.json
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/hand_contract_pose.json
